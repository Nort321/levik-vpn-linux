{
  "name": "levik-vpn-linux",
  "version": "1.0.0",
  "private": true,
  "description": "Official Levik VPN desktop client for Linux",
  "main": "dist/main/main.js",
  "author": {
    "name": "Levik VPN",
    "email": "support@leviknet.com"
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "npm run build && electron .",
    "lint": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "vitest run && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "download:xray": "node scripts/download-xray.mjs",
    "package:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "check": "npm run lint && npm run build && npm test"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.10",
    "jsdom": "^26.1.0",
    "typescript": "5.9.2",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.leviknet.vpn.linux",
    "productName": "Levik VPN",
    "artifactName": "LevikVPN-Linux-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/xray/linux-x64",
        "to": "xray",
        "filter": [
          "xray",
          "geoip.dat",
          "geosite.dat",
          "LICENSE",
          "VERSION"
        ]
      },
      {
        "from": "native",
        "to": "linux",
        "filter": [
          "levik-network.py",
          "xray-integrity.json"
        ]
      }
    ],
    "asar": true,
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Nort321/levik-vpn-linux/releases/latest/download"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "executableName": "levik-vpn",
      "desktop": {
        "entry": {
          "Name": "Levik VPN",
          "Comment": "Secure VPN connection",
          "Categories": "Network;VPN;",
          "Keywords": "VPN;Privacy;Network;"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libsecret-1-0",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libnotify4",
        "libgbm1",
        "libasound2t64 | libasound2",
        "python3 (>= 3.9)",
        "systemd-resolved | openresolv | resolvconf",
        "policykit-1 | polkitd",
        "pkexec",
        "nftables",
        "iproute2",
        "libcap2-bin",
        "util-linux",
        "passwd"
      ],
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4"
  },
  "homepage": "https://leviknet.com"
}
